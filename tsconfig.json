{
  "extends": "./.config/tsconfig.json",
  "include": ["src", "types"],
  "compilerOptions": {
    "jsx": "react",
    "rootDir": "./src",
    "baseUrl": "./src",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node10",
      "target": "es5",
      "esModuleInterop": true
    },
    "transpileOnly": true
  }
}
